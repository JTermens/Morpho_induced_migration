// Parameter file for a phase space exploration of durotaxis

verbosity=0;
// bool debug=1; 

// string rootDir = "/home/joan/Documents/Tesi_doct/Projects/Spontaneous_tissue_motility/Simul_runs/test";
string rootDir = "/home/joan/Documents/Simul_runs/exploration_semiplane";

string simulName = "exploration_semiplane_qLambda";

// Fixed parameters
real[int] LcList = [25];
real[int] LambdaList = [500];

real zi = 0.1;

// Mesh parameters
real lx = 4000;
real l0 = pi*LambdaList[0];
int nFinguers = 1;
real obd = 40.; // Boundary mesh density
real ibd = 10.; // Inner boundary mesh density
real bLayerWidth = 0.35;

// Exploration variables:

// Perturbation amplitude
real minAmp = 0;
real maxAmp = 0.6*l0;
real dAmp = (maxAmp-minAmp)/100;
// int nAmp = lrint((maxAmp-minAmp)/dAmp)+1; // 101; +1 to include the minimum value

// Monolayer contractility
real minZeta = 0;
real maxZeta = -250;
real dZeta = -1;
// int nZeta = lrint((maxZeta-minZeta)/dZeta)+1; // 251; +1 to include the minimum value

real[int] AmpList(101);
real[int] ZetaList(251);

for (int iAmp=0; iAmp<101; iAmp++) {AmpList[iAmp] = minAmp + dAmp*iAmp;}
for (int iZeta=0; iZeta<201; iZeta++) {ZetaList[iZeta] = minZeta + dZeta*iZeta;}

bool saveLocalSols = 0;
bool saveFreeBnd = 1;

int[int] i0Amp = [0,21,41,61,81];
int[int] ifAmp = [20,40,60,80,100];
