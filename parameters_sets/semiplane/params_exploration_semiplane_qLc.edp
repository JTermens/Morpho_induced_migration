// Parameter file for a phase space exploration of durotaxis

verbosity=0;
// bool debug=1; 

// string rootDir = "/home/joan/Documents/Tesi_doct/Projects/Spontaneous_tissue_motility/Simul_runs/exploration_semiplane";
string rootDir = "/home/joan/Documents/Simul_runs/exploration_semiplane";

string simulName = "exploration_semiplane_qLc";

// Fixed parameters
real[int] LcList = [25];
real[int] LambdaList = [500];

real zi = 0.1;

// Mesh parameters
real l0 = 2*pi*LcList[0];
real lx = 25*l0;
int nFingers = 1;
real obd = 50.; // Boundary mesh density
real ibd = 10.; // Inner boundary mesh density
real bLayerWidth = 0.35;

// Exploration variables:

// Perturbation amplitude
real minAmp = 0;
real maxAmp = 0.8*l0;
real dAmp = (maxAmp-minAmp)/200;
// int nAmp = lrint((maxAmp-minAmp)/dAmp)+1; // 201; +1 to include the minimum value

// Monolayer contractility
real minZeta = 0;
real maxZeta = -200;
real dZeta = -1;
// int nZeta = lrint((maxZeta-minZeta)/dZeta)+1; // 201; +1 to include the minimum value

real[int] AmpList(201);
real[int] ZetaList(201);

for (int iAmp=0; iAmp<201; iAmp++) {AmpList[iAmp] = minAmp + dAmp*iAmp;}
for (int iZeta=0; iZeta<201; iZeta++) {ZetaList[iZeta] = minZeta + dZeta*iZeta;}

bool saveLocalSols = 0;
bool saveFreeBnd = 1;

int[int] i0Amp = [0,41,81,121,161];
int[int] ifAmp = [40,80,120,160,200];
